<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.1"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd">

    <persistence-unit name="udemy_maven">
        <!--
        Mesmo usando somente o Hibernate nesse projeto, é uma boa prática deixar claro qual
        será utilizado.
        Por isso o uso do <provaider />
        -->
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!--Serve para informar ao provider quais são as minhas entidades para usar com o banco. -->
        <class>modelo.basico.usuario.Usuario</class>
        <class>modelo.basico.produto.Produto</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/curso_java"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="123456789"/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>

</persistence>

<!--
    Oracle não usa mais "javax." para se trabalhar dentro do property, com isso partir da
    versão 3.0 é necessário usar o "jakarta."

    Outra alteração é que versões 5.x do Connector/J era comum usar: com.mysql.jdbc.Driver.
    Agora nas versões mais novas, 6.x, é comum usar: com.mysql.cj.jdbc.Driver.
    Esse "cj" significa "Connector/J"
-->